{
  // Cloudflare Worker "quiet-disk-558e", serving https://aiosqa.dpdns.org: deployed on every push to main (Workers Builds), or by hand with
  // `npx wrangler deploy` from this folder. Keep this file in step with the dashboard: a deploy applies what is here.
  "name": "quiet-disk-558e",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" },
  // Counts for /download and the page's /e beacon (no cookies, no IPs); read them with tools/site-stats.sh.
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "aios_site" }],
  // The feedback form (/feedback) emails this address. RESEND_API_KEY is NOT here: this repository is public. It is a
  // Secret (encrypted) on the Worker, set in the dashboard (Settings > Variables and Secrets > type Secret) or with
  // `npx wrangler secret put RESEND_API_KEY`; secrets are kept across deploys, plain variables are replaced by this file.
  "vars": { "FEEDBACK_TO": "vxtien2000@gmail.com" },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
