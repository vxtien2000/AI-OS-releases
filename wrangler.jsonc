{
  // Cloudflare Worker for aiosqa.com: deployed on every push to main (Workers Builds), or by hand with
  // `npx wrangler deploy` from this folder. Keep this file in step with the dashboard: a deploy applies what is here.
  "name": "quiet-disk-558e",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
